{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "build/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|Inter|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, Inter, Source Serif 4."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-on",
      "--baseline",
      "--bg",
      "--bg-rule",
      "--col-gap",
      "--col-meta-w",
      "--ff-body",
      "--ff-display",
      "--ff-mono",
      "--fs-body",
      "--fs-caption",
      "--fs-display",
      "--fs-h1",
      "--fs-h2",
      "--fs-h3",
      "--fs-mono",
      "--fs-small",
      "--fw-medium",
      "--fw-regular",
      "--fw-semibold",
      "--ink-1",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--ink-body",
      "--ink-fade",
      "--ink-meta",
      "--ink-quiet",
      "--lh-body",
      "--lh-display",
      "--lh-loose",
      "--lh-snug",
      "--lh-tight",
      "--margin-bot",
      "--margin-side",
      "--margin-top",
      "--page-h",
      "--page-w",
      "--rule-weight",
      "--s-0",
      "--s-1",
      "--s-10",
      "--s-2",
      "--s-3",
      "--s-4",
      "--s-5",
      "--s-6",
      "--s-7",
      "--s-8",
      "--s-9",
      "--sep-gap-loose",
      "--sep-gap-tight",
      "--tr-display",
      "--tr-h2",
      "--tr-mono",
      "--tr-tight",
      "--vr-1",
      "--vr-1-5",
      "--vr-2",
      "--vr-half"
    ],
    "tokenKinds": {
      "--bg": "color",
      "--bg-rule": "color",
      "--ink-1": "color",
      "--ink-2": "color",
      "--ink-3": "color",
      "--ink-4": "color",
      "--ink-body": "color",
      "--ink-meta": "color",
      "--ink-quiet": "color",
      "--ink-fade": "color",
      "--accent": "color",
      "--accent-on": "color",
      "--ff-display": "font",
