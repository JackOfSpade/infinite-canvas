{
  "name": "infinite-canvas",
  "description": "Infinite Canvas - An AI-powered workspace",
  "author": "Antigravity",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:compile": "vite build",
    "build": "node scripts/build-macos.mjs",
    "lint": "eslint .",
    "test:unit": "node --import ./scripts/test-stubs/register.mjs scripts/test-runner.js",
    "test:resume-pdf": "npm --prefix 'Job Application Design System/build' test",
    "test": "npm run test:unit && npm run test:resume-pdf",
    "test:e2e": "npm run build:compile && node scripts/electron-smoke.js",
    "test:job-apis": "node --import ./scripts/test-stubs/register.mjs scripts/run-api-tests.js",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.antigravity.infinitecanvas",
    "mac": {
      "target": "dir",
      "identity": "AI Chalkboard Local Code Signing",
      "forceCodeSigning": true
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "Job Application Design System",
        "to": "Job Application Design System",
        "filter": [
          "SKILL.md",
          "readme.md",
          "STYLE.md",
          "colors_and_type.css",
          "resume.css",
          "cover-letter.css",
          "resume.html",
          "cover-letter.html",
          "build/dual-mode-pdf.js"
        ]
      },
      {
        "from": "local_ai",
        "to": "local_ai"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "chromium-bidi": "^14.0.0",
    "electron-store": "^11.0.2",
    "google-auth-library": "^10.6.2",
    "html-to-text": "^9.0.5",
    "jsdom": "^29.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.59.1",
    "puppeteer-core": "^25.6.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@xyflow/react": "^12.10.2",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.1",
    "vite": "8.0.16",
    "vite-plugin-electron": "^0.29.1"
  }
}
