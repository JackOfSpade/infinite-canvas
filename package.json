{
  "name": "infinite-canvas",
  "description": "Infinite Canvas - An AI-powered workspace",
  "author": "Antigravity",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:compile": "vite build",
    "build": "node scripts/build-macos.mjs",
    "lint": "eslint .",
    "test:unit": "node --import ./scripts/test-stubs/register.mjs scripts/test-runner.js",
    "test:resume-pdf": "npm --prefix 'Job Application Design System/build' test",
    "test": "npm run test:unit && npm run test:resume-pdf",
    "test:e2e": "npm run build:compile && node scripts/electron-smoke.js",
    "test:e2e:bridge": "npm run build:compile && node scripts/electron-bridge-smoke.js",
    "test:tunnel": "node scripts/tunnel-supervisor-selftest.js",
    "selftest:handoff-bridge": "node --expose-gc --import ./scripts/test-stubs/register.mjs scripts/handoff-bridge-conformance.js --suite=all",
    "test:job-apis": "node --import ./scripts/test-stubs/register.mjs scripts/run-api-tests.js",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.antigravity.infinitecanvas",
    "mac": {
      "target": "dir",
      "identity": "AI Chalkboard Local Code Signing",
      "forceCodeSigning": true
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      {
        "from": "Job Application Design System",
        "to": "Job Application Design System",
        "filter": [
          "SKILL.md",
          "CONTENT_RULES.md",
          "STYLE.md",
          "colors_and_type.css",
          "resume.css",
          "cover-letter.css",
          "resume.html",
          "cover-letter.html",
          "build/dual-mode-pdf.js"
        ]
      },
      {
        "from": "local_ai",
        "to": "local_ai"
      }
    ]
  },
  "dependencies": {
    "chromium-bidi": "^14.0.0",
    "electron-store": "^11.0.2",
    "html-to-text": "^9.0.5",
    "jsdom": "^29.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "1.59.1",
    "puppeteer-core": "^25.6.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "tinyld": "^1.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12.10.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.4.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.0.16",
    "vite-plugin-electron": "^0.29.1"
  }
}
